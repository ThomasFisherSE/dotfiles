#!/usr/bin/env bash
set -euo pipefail

PROJECT="$(realpath "$PWD")"
if [[ "$PROJECT" == "$HOME" ]]; then
  PROJECT_DISPLAY="~"
elif [[ "$PROJECT" == "$HOME"/* ]]; then
  PROJECT_DISPLAY="~/${PROJECT#"$HOME"/}"
else
  PROJECT_DISPLAY="$PROJECT"
fi
PI_HOME="$HOME/.pi/agent"
SANDBOX_HOME="/home/sandbox"
DOTFILES_DIR="$HOME/dotfiles"
HOST_BROKER_SCRIPT="${PI_HOST_BROKER_SCRIPT:-$HOME/.local/bin/pi-host-broker}"
if [[ ! -x "$HOST_BROKER_SCRIPT" && -x "$DOTFILES_DIR/pi/.local/bin/pi-host-broker" ]]; then
  HOST_BROKER_SCRIPT="$DOTFILES_DIR/pi/.local/bin/pi-host-broker"
fi
HOST_BROKER_SOCKET="${PI_HOST_BROKER_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pi-host-broker-$$.sock}"
OBSIDIAN_VAULT="${PI_OBSIDIAN_VAULT:-$HOME/dev/obsidian}"
SANDBOX_OBSIDIAN_VAULT="$SANDBOX_HOME/dev/obsidian"
SANDBOX_GITCONFIG="$PI_HOME/gitconfig"
HOST_UID="$(id -u)"
HOST_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$HOST_UID}"
SANDBOX_RUNTIME_DIR="/run/user/$HOST_UID"
GUI_RUNTIME_DIR_ADDED=0
BROKER_PID=""

cleanup() {
  if [[ -n "$BROKER_PID" ]]; then
    kill "$BROKER_PID" >/dev/null 2>&1 || true
  fi
  rm -f "$HOST_BROKER_SOCKET"
}
trap cleanup EXIT

mkdir -p "$PI_HOME"

# Pi extensions are installed by stow from pi/.pi/agent/extensions into ~/.pi/agent/extensions.

# Provide only the host's Git author identity inside the sandbox. Avoid binding the
# full ~/.gitconfig because it may include credential helpers, signing keys, or includes.
HOST_GIT_NAME="$(git config --global --includes --get user.name 2>/dev/null || true)"
HOST_GIT_EMAIL="$(git config --global --includes --get user.email 2>/dev/null || true)"
if [[ -n "$HOST_GIT_NAME" && -n "$HOST_GIT_EMAIL" ]]; then
  rm -f "$SANDBOX_GITCONFIG"
  git config --file "$SANDBOX_GITCONFIG" user.name "$HOST_GIT_NAME"
  git config --file "$SANDBOX_GITCONFIG" user.email "$HOST_GIT_EMAIL"
  chmod 600 "$SANDBOX_GITCONFIG"
else
  rm -f "$SANDBOX_GITCONFIG"
fi

# Start a per-pi-sandbox host broker outside the sandbox. The sandbox only sees its Unix socket.
# Per-session sockets keep terminal approvals attached to the terminal that launched this Pi.
if [[ -x "$HOST_BROKER_SCRIPT" ]]; then
  mkdir -p "$(dirname "$HOST_BROKER_SOCKET")"
  env PI_HOST_BROKER_SOCKET="$HOST_BROKER_SOCKET" "$HOST_BROKER_SCRIPT" start \
    >"${XDG_RUNTIME_DIR:-/tmp}/pi-host-broker-$$.log" 2>&1 &
  BROKER_PID="$!"
  for _ in {1..20}; do
    PI_HOST_BROKER_SOCKET="$HOST_BROKER_SOCKET" "$HOST_BROKER_SCRIPT" ping >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

ensure_gui_runtime_dir() {
  if (( GUI_RUNTIME_DIR_ADDED )); then
    return
  fi
  args+=(--dir /run/user)
  args+=(--dir "$SANDBOX_RUNTIME_DIR")
  args+=(--setenv XDG_RUNTIME_DIR "$SANDBOX_RUNTIME_DIR")
  GUI_RUNTIME_DIR_ADDED=1
}

bind_runtime_socket() {
  local name="$1"
  local host_path="$HOST_RUNTIME_DIR/$name"
  local sandbox_path="$SANDBOX_RUNTIME_DIR/$name"
  if [[ -S "$host_path" ]]; then
    ensure_gui_runtime_dir
    args+=(--bind "$host_path" "$sandbox_path")
    return 0
  fi
  return 1
}

args=(
  --die-with-parent
  --unshare-all
  --share-net

  # Basic runtime environment.
  --dev-bind /dev /dev
  --proc /proc
  --tmpfs /tmp
  --tmpfs /home
  --dir /run
  --dir "$SANDBOX_HOME"
  --dir "$SANDBOX_HOME/.pi"
  --dir "$SANDBOX_HOME/dev"

  # Keep the sandbox focused on the current project.
  --bind "$PROJECT" /workspace
  --bind "$PI_HOME" "$SANDBOX_HOME/.pi/agent"
  --dir "$SANDBOX_HOME/dotfiles"
  --ro-bind "$DOTFILES_DIR" "$SANDBOX_HOME/dotfiles"
  --ro-bind "$HOME/.agents" "$SANDBOX_HOME/.agents"
  --dir "$SANDBOX_HOME/.codex"
  --dir "$SANDBOX_HOME/.claude"
  --ro-bind "$HOME/.codex/skills" "$SANDBOX_HOME/.codex/skills"
  --ro-bind "$HOME/.claude/skills" "$SANDBOX_HOME/.claude/skills"
  --chdir /workspace

  # System files/binaries, read-only.
  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
  --ro-bind /etc /etc
  --ro-bind /opt /opt
  --ro-bind /sys /sys

  # Minimal environment.
  --setenv HOME "$SANDBOX_HOME"
  --setenv USER sandbox
  --setenv PATH "$SANDBOX_HOME/.pi/agent/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"
  --setenv TERM "${TERM:-xterm-256color}"
  --setenv PI_SANDBOX 1
  --setenv PI_SANDBOX_HOST_PROJECT "$PROJECT"
  --setenv PI_SANDBOX_HOST_PROJECT_DISPLAY "$PROJECT_DISPLAY"
)

# Keep the Obsidian vault available in every sandbox session, independent of
# the current project. Override with PI_OBSIDIAN_VAULT=/path/to/vault.
if [[ -d "$OBSIDIAN_VAULT" ]]; then
  args+=(--bind "$OBSIDIAN_VAULT" "$SANDBOX_OBSIDIAN_VAULT")
  args+=(--setenv PI_OBSIDIAN_VAULT "$SANDBOX_OBSIDIAN_VAULT")
fi

# Expose only the host broker socket, not the host filesystem.
if [[ -S "$HOST_BROKER_SOCKET" ]]; then
  args+=(--bind "$HOST_BROKER_SOCKET" /run/pi-host-broker.sock)
  args+=(--setenv PI_HOST_BROKER_SOCKET /run/pi-host-broker.sock)
fi

# Optional desktop/GPU display integration. /dev is already bound above, which
# exposes GPU device nodes. These socket binds let GUI/GPU clients talk to the
# host Wayland/X11/session services without mounting the whole host runtime dir.
# Set PI_SANDBOX_GUI=0 to disable this bridge for a session.
if [[ "${PI_SANDBOX_GUI:-1}" != "0" ]]; then
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    if [[ "$WAYLAND_DISPLAY" = /* && -S "$WAYLAND_DISPLAY" ]]; then
      ensure_gui_runtime_dir
      args+=(--bind "$WAYLAND_DISPLAY" "$WAYLAND_DISPLAY")
      args+=(--setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY")
    elif bind_runtime_socket "$WAYLAND_DISPLAY"; then
      args+=(--setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY")
    fi
  fi

  if [[ -n "${DISPLAY:-}" ]]; then
    args+=(--setenv DISPLAY "$DISPLAY")
    if [[ -d /tmp/.X11-unix ]]; then
      args+=(--bind /tmp/.X11-unix /tmp/.X11-unix)
    fi
    HOST_XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
    if [[ -f "$HOST_XAUTHORITY" ]]; then
      args+=(--ro-bind "$HOST_XAUTHORITY" /run/pi-Xauthority)
      args+=(--setenv XAUTHORITY /run/pi-Xauthority)
    fi
  fi

  if [[ "${DBUS_SESSION_BUS_ADDRESS:-}" =~ ^unix:path=([^,]+) ]]; then
    DBUS_HOST_PATH="${BASH_REMATCH[1]}"
    if [[ -S "$DBUS_HOST_PATH" ]]; then
      ensure_gui_runtime_dir
      DBUS_SANDBOX_PATH="$SANDBOX_RUNTIME_DIR/$(basename "$DBUS_HOST_PATH")"
      args+=(--bind "$DBUS_HOST_PATH" "$DBUS_SANDBOX_PATH")
      args+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$DBUS_SANDBOX_PATH")
    fi
  elif bind_runtime_socket bus; then
    args+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$SANDBOX_RUNTIME_DIR/bus")
  fi

  # Audio/media sockets are useful for browser previews, game prototypes, and
  # VA-API/PipeWire capture tests. Bind only the conventional socket paths.
  bind_runtime_socket pipewire-0 >/dev/null || true
  bind_runtime_socket pipewire-0-manager >/dev/null || true
  if [[ -S "$HOST_RUNTIME_DIR/pulse/native" ]]; then
    ensure_gui_runtime_dir
    args+=(--dir "$SANDBOX_RUNTIME_DIR/pulse")
    args+=(--bind "$HOST_RUNTIME_DIR/pulse/native" "$SANDBOX_RUNTIME_DIR/pulse/native")
    args+=(--setenv PULSE_SERVER "unix:$SANDBOX_RUNTIME_DIR/pulse/native")
  fi
fi

# Make commits work in fresh repos without exposing the host's full Git config.
if [[ -f "$SANDBOX_GITCONFIG" ]]; then
  args+=(--ro-bind "$SANDBOX_GITCONFIG" "$SANDBOX_HOME/.gitconfig")
fi

# Forward the SSH agent socket when available. This enables git push/fetch and
# SSH commit signing without exposing ~/.ssh private key files to the sandbox.
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
  args+=(--bind "$SSH_AUTH_SOCK" /run/ssh-agent.sock)
  args+=(--setenv SSH_AUTH_SOCK /run/ssh-agent.sock)
fi

# Arch commonly has /lib64, but only bind it if present.
if [[ -e /lib64 ]]; then
  args+=(--ro-bind /lib64 /lib64)
fi

# GPU/user-space drivers commonly consult udev metadata for device discovery.
if [[ -e /run/udev ]]; then
  args+=(--ro-bind /run/udev /run/udev)
fi

# On many Arch systems /etc/resolv.conf points into /run/systemd/resolve.
# Bind that target so DNS works inside the sandbox.
if [[ -e /run/systemd/resolve ]]; then
  args+=(--ro-bind /run/systemd/resolve /run/systemd/resolve)
fi

# Pass through common provider/API environment variables when present.
for name in \
  ANTHROPIC_API_KEY \
  OPENAI_API_KEY \
  AZURE_OPENAI_API_KEY \
  AZURE_OPENAI_BASE_URL \
  AZURE_OPENAI_RESOURCE_NAME \
  AZURE_OPENAI_API_VERSION \
  AZURE_OPENAI_DEPLOYMENT_NAME_MAP \
  DEEPSEEK_API_KEY \
  GEMINI_API_KEY \
  GOOGLE_CLOUD_PROJECT \
  GOOGLE_CLOUD_LOCATION \
  GOOGLE_APPLICATION_CREDENTIALS \
  MISTRAL_API_KEY \
  GROQ_API_KEY \
  CEREBRAS_API_KEY \
  CLOUDFLARE_API_KEY \
  CLOUDFLARE_ACCOUNT_ID \
  CLOUDFLARE_GATEWAY_ID \
  XAI_API_KEY \
  OPENROUTER_API_KEY \
  AI_GATEWAY_API_KEY \
  ZAI_API_KEY \
  OPENCODE_API_KEY \
  HF_TOKEN \
  FIREWORKS_API_KEY \
  TOGETHER_API_KEY \
  KIMI_API_KEY \
  MINIMAX_API_KEY \
  MINIMAX_CN_API_KEY \
  XIAOMI_API_KEY \
  XIAOMI_TOKEN_PLAN_CN_API_KEY \
  XIAOMI_TOKEN_PLAN_AMS_API_KEY \
  XIAOMI_TOKEN_PLAN_SGP_API_KEY \
  AWS_PROFILE \
  AWS_ACCESS_KEY_ID \
  AWS_SECRET_ACCESS_KEY \
  AWS_SESSION_TOKEN \
  AWS_REGION \
  AWS_DEFAULT_REGION \
  AWS_BEARER_TOKEN_BEDROCK \
  AWS_ENDPOINT_URL_BEDROCK_RUNTIME \
  AWS_BEDROCK_SKIP_AUTH \
  AWS_BEDROCK_FORCE_HTTP1 \
  AWS_BEDROCK_FORCE_CACHE \
  PI_OFFLINE \
  PI_SKIP_VERSION_CHECK \
  PI_TELEMETRY \
  PI_CACHE_RETENTION \
  TERM_PROGRAM \
  TERM_PROGRAM_VERSION \
  COLORTERM \
  TMUX \
  XDG_CURRENT_DESKTOP \
  DESKTOP_SESSION \
  KDE_FULL_SESSION \
  QT_QPA_PLATFORM \
  GDK_BACKEND
 do
  if [[ -v "$name" ]]; then
    args+=(--setenv "$name" "${!name}")
  fi
done

bwrap "${args[@]}" /usr/bin/pi "$@"
