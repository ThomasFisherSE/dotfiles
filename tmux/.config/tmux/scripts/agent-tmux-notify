#!/usr/bin/env bash
set -euo pipefail

# Mark or clear the tmux window that owns the current agent pane.
# Usage:
#   agent-tmux-notify              # mark the agent window as needing attention
#   agent-tmux-notify clear        # clear the per-window attention style
#   agent-tmux-notify clear %1     # clear the window that owns pane %1
# Codex appends a JSON notification payload as argv. Only completion payloads
# should mark the window; other notification types are not actionable.
notify_option="@agent_tmux_notify"
cache_script="${AGENT_TMUX_NOTIFY_CACHE:-$HOME/.config/tmux/scripts/agent-tmux-notify-cache}"
target="${2:-}"

refresh_notification_cache() {
  if [[ -x "$cache_script" ]]; then
    "$cache_script" >/dev/null 2>&1 || true
  fi
  tmux refresh-client -S >/dev/null 2>&1 || true
}

clear_window_notification() {
  local target_window="$1"
  tmux set-window-option -q -t "$target_window" -u window-status-format
  tmux set-window-option -q -t "$target_window" -u window-status-current-format
  tmux set-window-option -q -t "$target_window" -u "$notify_option"
  refresh_notification_cache
}

case "${1:-mark}" in
  clear)
    mode="clear"
    ;;
  "" | mark)
    mode="mark"
    ;;
  \{*)
    if command -v jq >/dev/null 2>&1; then
      notification_type="$(jq -r '.type // empty' <<<"$1" 2>/dev/null || true)"
    elif [[ "$1" =~ \"type\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      notification_type="${BASH_REMATCH[1]}"
    else
      notification_type=""
    fi
    case "$notification_type" in
      agent-turn-complete | turn/completed) mode="mark" ;;
      *) exit 0 ;;
    esac
    ;;
  *)
    mode="mark"
    ;;
esac

if ! command -v tmux >/dev/null 2>&1; then
  exit 0
fi

find_tmux_pane() {
  if [[ -n "$target" ]]; then
    tmux display-message -p -t "$target" "#{pane_id}" 2>/dev/null && return 0
  fi

  if [[ -n "${TMUX_PANE:-}" ]]; then
    printf '%s\n' "$TMUX_PANE"
    return 0
  fi

  local ancestors=" " pane_id pane_pid parent pid="$$"
  while [[ -r "/proc/$pid/status" ]]; do
    ancestors+="$pid "
    parent="$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null || true)"
    if [[ -z "$parent" || "$parent" == "0" || "$parent" == "$pid" ]]; then
      break
    fi
    pid="$parent"
  done

  while read -r pane_pid pane_id; do
    if [[ "$ancestors" == *" $pane_pid "* ]]; then
      printf '%s\n' "$pane_id"
      return 0
    fi
  done < <(tmux list-panes -a -F '#{pane_pid} #{pane_id}' 2>/dev/null || true)
}

pane_id="$(find_tmux_pane || true)"
if [[ -z "$pane_id" ]]; then
  exit 0
fi

window_id="$(tmux display-message -p -t "$pane_id" "#{window_id}" 2>/dev/null || true)"
if [[ -z "$window_id" ]]; then
  exit 0
fi

if [[ "$mode" == "clear" ]]; then
  clear_window_notification "$window_id"
  exit 0
fi

window_is_visible() {
  local target_window="$1"
  local visible_window

  while read -r visible_window; do
    if [[ "$visible_window" == "$target_window" ]]; then
      return 0
    fi
  done < <(tmux list-clients -F '#{window_id}' 2>/dev/null || true)

  return 1
}

# The marker is only useful for windows that are not visible to an attached
# tmux client. A background session can still have an "active" window.
if window_is_visible "$window_id"; then
  clear_window_notification "$window_id"
  exit 0
fi

attention_color="${AGENT_TMUX_NOTIFY_COLOR:-#{@thm_red}}"
base_format="$(tmux show-option -gqv window-status-format 2>/dev/null || true)"
if [[ -n "$base_format" ]]; then
  tmux set-window-option -q -t "$window_id" window-status-format \
    "${base_format//\#\{@thm_overlay_2\}/$attention_color}"
fi

tmux set-window-option -q -t "$window_id" "$notify_option" "1"
refresh_notification_cache
