#!/usr/bin/env bash
set -euo pipefail

# Mark or clear the tmux window that owns the current agent pane.
# Usage:
#   agent-tmux-notify        # mark the agent window as needing attention
#   agent-tmux-notify clear  # clear the per-window attention style
# Codex appends a JSON notification payload as argv. Only completion payloads
# should mark the window; other notification types are not actionable.
case "${1:-mark}" in
  clear)
    mode="clear"
    ;;
  "" | mark)
    mode="mark"
    ;;
  \{*)
    if command -v jq >/dev/null 2>&1; then
      notification_type="$(jq -r '.type // empty' <<<"$1" 2>/dev/null || true)"
    elif [[ "$1" =~ \"type\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      notification_type="${BASH_REMATCH[1]}"
    else
      notification_type=""
    fi
    case "$notification_type" in
      agent-turn-complete | turn/completed) mode="mark" ;;
      *) exit 0 ;;
    esac
    ;;
  *)
    mode="mark"
    ;;
esac

if ! command -v tmux >/dev/null 2>&1; then
  exit 0
fi

find_tmux_pane() {
  if [[ -n "${TMUX_PANE:-}" ]]; then
    printf '%s\n' "$TMUX_PANE"
    return 0
  fi

  local ancestors=" " pane_id pane_pid parent pid="$$"
  while [[ -r "/proc/$pid/status" ]]; do
    ancestors+="$pid "
    parent="$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null || true)"
    if [[ -z "$parent" || "$parent" == "0" || "$parent" == "$pid" ]]; then
      break
    fi
    pid="$parent"
  done

  while read -r pane_pid pane_id; do
    if [[ "$ancestors" == *" $pane_pid "* ]]; then
      printf '%s\n' "$pane_id"
      return 0
    fi
  done < <(tmux list-panes -a -F '#{pane_pid} #{pane_id}' 2>/dev/null || true)
}

pane_id="$(find_tmux_pane || true)"
if [[ -z "$pane_id" ]]; then
  exit 0
fi

window_id="$(tmux display-message -p -t "$pane_id" "#{window_id}" 2>/dev/null || true)"
if [[ -z "$window_id" ]]; then
  exit 0
fi

if [[ "$mode" == "clear" ]]; then
  tmux set-window-option -q -t "$window_id" -u window-status-format
  tmux set-window-option -q -t "$window_id" -u window-status-current-format
  exit 0
fi

# The marker is only useful for windows that are not currently visible.
if [[ "$(tmux display-message -p -t "$window_id" "#{window_active}" 2>/dev/null || printf '0')" == "1" ]]; then
  tmux set-window-option -q -t "$window_id" -u window-status-format
  tmux set-window-option -q -t "$window_id" -u window-status-current-format
  exit 0
fi

attention_color="${AGENT_TMUX_NOTIFY_COLOR:-#{@thm_red}}"
base_format="$(tmux show-option -gqv window-status-format 2>/dev/null || true)"
if [[ -n "$base_format" ]]; then
  tmux set-window-option -q -t "$window_id" window-status-format \
    "${base_format//\#\{@thm_overlay_2\}/$attention_color}"
fi
