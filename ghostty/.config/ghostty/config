# Match the Alacritty workflow: open maximized and attach to tmux.
maximize = true
command = shell:tmux attach || tmux new-session

font-family = JetBrainsMono Nerd Font
font-size = 12

# Match Alacritty's built-in default dark palette.
background = #181818
foreground = #d8d8d8
selection-foreground = cell-background
selection-background = cell-foreground
cursor-color = cell-foreground
cursor-text = cell-background
palette = 0=#181818
palette = 1=#ac4242
palette = 2=#90a959
palette = 3=#f4bf75
palette = 4=#6a9fb5
palette = 5=#aa759f
palette = 6=#75b5aa
palette = 7=#d8d8d8
palette = 8=#6b6b6b
palette = 9=#c55555
palette = 10=#aac474
palette = 11=#feca88
palette = 12=#82b8c8
palette = 13=#c28cb8
palette = 14=#93d3c3
palette = 15=#f8f8f8

window-padding-x = 0
window-padding-y = 0
gtk-titlebar = false

bell-features = no-system,audio,attention,title
bell-audio-path = /usr/share/sounds/freedesktop/stereo/bell.oga

# Keep Shift+Enter behavior aligned with the Alacritty CSI-u binding.
keybind = shift+enter=csi:13;2u
